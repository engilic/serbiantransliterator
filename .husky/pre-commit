#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Fail fast ako postoje merge conflict markeri bilo gde u repo-u
npm run check:conflicts

# i18n guard: zabrani hardcoded user-facing stringove (setStatus/showModalInfo/status_error_prefix arg)
npm run check:i18n

# Format staged fajlova (prettier) + ostalo
npx lint-staged
