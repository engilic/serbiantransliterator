{
    "name": "Serbian Transliterator",
    "short_name": "Srpski Trans",
    "start_url": "./index.html",
    "display": "standalone",
    "background_color": "#ffffff",
    "theme_color": "#0f6cbd",
    "description": "Najbrži offline preslovljivač (Lat ↔ Ćir).",
    "icons": [
        {
            "src": "assets/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "assets/icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "file_handlers": [
        {
            "action": "/index.html",
            "accept": {
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
            }
        }
    ]
}
