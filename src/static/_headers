/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; script-src 'self' https://appsforoffice.microsoft.com https://ajax.aspnetcdn.com; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors https://*.office.com https://*.officeapps.live.com https://*.microsoft.com https://*.sharepoint.com https://*.sharepoint-df.com;

# [MAX3] Immutable Cache za hashovane fajlove u korenu (Webpack output)
# Ovi fajlovi imaju hash u imenu (npr. taskpane.a1b2c3.js), pa ih mozemo kesirati zauvek.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.wasm
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Binarni rečnici u assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML se NE kešira agresivno (entry point mora biti svež da bi povukao novi JS/CSS)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
