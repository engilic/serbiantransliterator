/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  
  # MAX SECURITY CSP
  # default-src 'none': Blokiraj sve što nije eksplicitno dozvoljeno.
  # script-src: Dozvoli samo naše skripte ('self') i Office.js (Microsoft CDN).
  # style-src: Dozvoli naše stilove i inline stilove (jer React/JS često dodaju style="...").
  # connect-src: Dozvoli fetch samo ka istom domenu (za .bin rečnike).
  # img-src: Dozvoli slike sa istog domena i data: (base64 slike).
  # frame-ancestors: Dozvoli da nas učita Office (Word).
  
  Content-Security-Policy: default-src 'none'; script-src 'self' https://appsforoffice.microsoft.com https://ajax.aspnetcdn.com; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors https://*.office.com https://*.officeapps.live.com https://*.microsoft.com https://*.sharepoint.com https://*.sharepoint-df.com;

/assets/*
  Cache-Control: public, max-age=31536000, immutable
