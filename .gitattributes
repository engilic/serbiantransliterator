###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

###############################################################################
# behavior for image files
#
# image files are treated as binary by default.
###############################################################################
#*.jpg   binary
#*.png   binary
#*.gif   binary

# Source / config (force LF)
*.ts   text eol=lf
*.js   text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.xml  text eol=lf
*.ps1  text eol=lf
*.sh   text eol=lf

# Windows batch files are safest with CRLF
*.bat  text eol=crlf

# Husky hooks must be LF (shell scripts)
.husky/* text eol=lf
