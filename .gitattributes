###############################################################################
# Global rule: store ALL text files in the repo as LF (cross-platform stable)
###############################################################################
* text=auto eol=lf

# Ensure these dotfiles are always LF
.gitattributes text eol=lf
.gitignore     text eol=lf

###############################################################################
# Windows scripts: safest with CRLF
###############################################################################
*.bat text eol=crlf
*.cmd text eol=crlf

###############################################################################
# Husky hooks must be LF (shell scripts)
###############################################################################
.husky/* text eol=lf

###############################################################################
# Lockfiles / manifests (explicit, though covered by global rule)
###############################################################################
Cargo.lock      text eol=lf
pnpm-lock.yaml  text eol=lf
*.lock          text eol=lf

###############################################################################
# Binaries (NEVER treat as text)
###############################################################################
# WASM / archives
*.wasm  binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.7z    binary

# Images / icons
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary

# Fonts
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary

# PDFs
*.pdf   binary

# Certificates / keys
*.pfx   binary
*.p12   binary

# Executables
*.exe   binary
*.dll   binary
