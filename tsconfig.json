{
    "compilerOptions": {
        "target": "es2018",
        "lib": ["es2018", "dom"],
        "allowJs": true,
        "baseUrl": ".",
        "esModuleInterop": true,
        "noEmitOnError": true,
        "outDir": "dist",
        "sourceMap": true,

        "module": "ESNext",
        "moduleResolution": "bundler"
    },
    "exclude": ["node_modules", "dist", "scripts"]
}
