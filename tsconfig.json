{
    "compilerOptions": {
        "target": "es2018",
        "lib": ["es2018", "dom", "webworker"],
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "noEmitOnError": true,
        "outDir": "dist",
        "sourceMap": true,

        "module": "ESNext",
        "moduleResolution": "bundler",

        "resolveJsonModule": true,
        "skipLibCheck": true,

        "paths": {
            "*": ["./*"]
        }
    },
    "exclude": ["node_modules", "dist", "scripts"]
}
