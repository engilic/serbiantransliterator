{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "_comment": "Serbian Transliterator Mutation Config",
    "testRunner": "vitest",
    "mutator": {
        "excludedMutations": ["ConsoleLogging"]
    },
    "reporters": ["html", "clear-text", "progress"],
    "coverageAnalysis": "perTest",
    "tsconfigFile": "tsconfig.json",

    "//": "--- DODATO: IGNORIŠI SMEĆE I ZAKLJUČANE FAJLOVE ---",
    "ignorePatterns": [
        ".vs",
        ".git",
        "dist",
        "coverage",
        ".stryker-tmp",
        "playwright-report",
        "test-results",
        "*.tsbuildinfo"
    ],

    "mutate": [
        "src/**/*.ts",
        "!src/**/*.d.ts",
        "!src/wasm-core/**",
        "!src/static/**",
        "!src/**/index.ts",
        "!src/taskpane/worker/transliteration.worker.ts",
        "!tests/**"
    ],
    "vitest": {
        "configFile": "vitest.config.ts"
    },
    "thresholds": {
        "high": 80,
        "low": 60,
        "break": 50
    },
    "timeoutMS": 10000
}
