{
    "name": "serbian-transliterator",
    "version": "1.0.0",
    "description": "Offline-first Word add-in for Serbian transliteration (Lat <-> Cyr) powered by Rust/WASM.",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    },
    "scripts": {
        "git:reset": "node scripts/git-cleanup.js",
        "verify:all": "node scripts/verify-all.js",
        "update:version": "node scripts/update-manifest-version.js",
        "clean": "node -e \"['dist','coverage','playwright-report','test-results','src/wasm-core/pkg','src/wasm-core/target'].forEach(d => { try { require('fs').rmSync(d, { recursive: true, force: true }); } catch(e) {} })\"",
        "wasm:build": "cd src/wasm-core && wasm-pack build --target web --out-name index",
        "dicts:compile": "cd src/wasm-core && cargo run --bin compiler && cd ../..",
        "dev-server": "webpack serve --mode development",
        "start": "npm run wasm:build && npm run dicts:compile && npm run dev-server",
        "build": "npm run wasm:build && npm run dicts:compile && webpack --mode production",
        "sideload:word": "office-addin-dev-settings sideload manifest.xml --app word",
        "dev": "concurrently --kill-others \"npm run start\" \"wait-on https://localhost:3000/taskpane.html && npm run sideload:word\"",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:fuzz": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run tests/fuzz",
        "test:coverage": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run --coverage",
        "test:e2e": "playwright test",
        "format:fix": "prettier --write .",
        "audit:high": "npm audit --audit-level=high"
    },
    "dependencies": {
        "core-js": "3.37.1",
        "dompurify": "3.3.1",
        "idb": "8.0.3",
        "jszip": "3.10.1",
        "regenerator-runtime": "0.14.1"
    },
    "devDependencies": {
        "@microsoft/office-js": "latest",
        "@types/office-js": "latest",
        "@axe-core/playwright": "latest",
        "@babel/core": "7.25.2",
        "@babel/preset-env": "7.25.4",
        "@babel/preset-typescript": "7.24.7",
        "@commitlint/cli": "20.4.0",
        "@commitlint/config-conventional": "20.4.0",
        "@playwright/test": "1.58.1",
        "@types/dompurify": "3.0.5",
        "@types/node": "20.8.4",
        "@vitest/coverage-v8": "3.2.4",
        "babel-loader": "9.1.3",
        "compression-webpack-plugin": "11.1.0",
        "concurrently": "8.2.2",
        "copy-webpack-plugin": "11.0.0",
        "cross-env": "10.1.0",
        "css-loader": "7.1.2",
        "eslint": "8.57.1",
        "eslint-plugin-office-addins": "latest",
        "fast-check": "4.5.3",
        "html-loader": "5.1.0",
        "html-webpack-plugin": "5.6.0",
        "http-server": "14.1.1",
        "husky": "9.1.7",
        "jsdom": "22.1.0",
        "lint-staged": "16.2.7",
        "mini-css-extract-plugin": "2.10.0",
        "office-addin-debugging": "latest",
        "office-addin-dev-certs": "latest",
        "office-addin-dev-settings": "latest",
        "office-addin-manifest": "latest",
        "prettier": "3.2.5",
        "rimraf": "6.1.2",
        "standard-version": "9.5.0",
        "terser-webpack-plugin": "5.3.11",
        "typescript": "5.4.5",
        "vitest": "3.2.4",
        "wait-on": "7.2.0",
        "webpack": "5.104.1",
        "webpack-cli": "5.1.4",
        "webpack-dev-server": "5.2.3",
        "webpack-merge": "6.0.1",
        "ts-loader": "9.5.1",
        "@typescript-eslint/eslint-plugin": "7.18.0",
        "@typescript-eslint/parser": "7.18.0"
    },
    "lint-staged": {
        "**/*.{ts,js,cjs,mjs,json,css,md,html}": [
            "prettier --write"
        ]
    },
    "overrides": {
        "eslint": "8.57.1",
        "@typescript-eslint/eslint-plugin": "7.18.0",
        "@typescript-eslint/parser": "7.18.0",
        "braces": "3.0.3",
        "micromatch": "4.0.8",
        "cross-spawn": "7.0.6",
        "tmp": "0.2.3",
        "nanoid": "3.3.8",
        "esbuild": "0.25.0",
        "webpack": "5.104.1",
        "vitest": "3.2.4",
        "@vitest/coverage-v8": "3.2.4",
        "@playwright/test": "1.58.1",
        "playwright": "1.58.1",
        "@eslint-community/eslint-utils": "4.4.1"
    }
}
