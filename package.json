{
    "name": "serbian-transliterator",
    "version": "1.0.0",
    "description": "Offline-first Word add-in for Serbian transliteration (Lat <-> Cyr) powered by Rust/WASM.",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    },
    "scripts": {
        "git:reset": "node scripts/git-cleanup.js",
        "verify:all": "node scripts/verify-all.js",
        "verify:all:strict": "node scripts/verify-all.js --strict",
        "update:version": "node scripts/update-manifest-version.js",
        "clean": "rimraf dist coverage playwright-report test-results pkg src/wasm-core/pkg",
        "build:wasm": "cd src/wasm-core && wasm-pack build --target web --out-name index",
        "compile:dicts": "cd src/wasm-core && cargo run --bin compiler && cd ../..",
        "prebuild": "npm run clean && npm run update:version",
        "build": "npm run build:wasm && npm run compile:dicts && webpack --mode production",
        "dev-server": "npm run build:wasm && npm run compile:dicts && webpack serve --mode development",
        "start": "npm run dev-server",
        "sideload:word": "office-addin-dev-settings sideload manifest.xml --app word",
        "dev": "concurrently --kill-others \"npm run start\" \"wait-on https://localhost:3000/taskpane.html && npm run sideload:word\"",
        "validate": "office-addin-manifest validate manifest.xml",
        "validate:prod": "office-addin-manifest validate manifest.prod.xml",
        "test": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run",
        "test:coverage": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run --coverage",
        "test:e2e": "playwright test",
        "lint": "eslint src/**/*.ts --max-warnings 0",
        "lint:fix": "eslint src/**/*.ts --fix",
        "typecheck": "tsc --noEmit",
        "serve:dist": "http-server dist -p 4173 -c-1",
        "check:conflicts": "node scripts/checkConflicts.cjs",
        "check:i18n": "node scripts/checkI18nKeys.cjs && node scripts/checkUserFacingStrings.cjs && node scripts/checkTaskpaneHtmlI18n.cjs",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "audit:high": "npm audit --audit-level=high",
        "prepare": "husky install",
        "release": "standard-version"
    },
    "dependencies": {
        "core-js": "^3.37.1",
        "dompurify": "^3.3.1",
        "idb": "^8.0.3",
        "jszip": "^3.10.1",
        "regenerator-runtime": "^0.14.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.0",
        "@babel/core": "^7.25.2",
        "@babel/preset-env": "^7.25.4",
        "@babel/preset-typescript": "^7.24.7",
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "@playwright/test": "^1.44.1",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^25.0.9",
        "@types/office-js": "^1.0.568",
        "@vitest/coverage-v8": "^4.0.17",
        "@wasm-tool/wasm-pack-plugin": "^1.7.0",
        "babel-loader": "^9.1.3",
        "compression-webpack-plugin": "^11.1.0",
        "concurrently": "^9.2.1",
        "copy-webpack-plugin": "^11.0.0",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.2",
        "eslint": "^8.57.0",
        "eslint-plugin-office-addins": "^3.0.3",
        "fast-check": "^4.5.3",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.6",
        "http-server": "^14.1.1",
        "husky": "^9.1.7",
        "jsdom": "^22.1.0",
        "lint-staged": "^16.2.7",
        "mini-css-extract-plugin": "^2.10.0",
        "office-addin-debugging": "^6.0.6",
        "office-addin-dev-certs": "^2.0.6",
        "office-addin-dev-settings": "^3.0.6",
        "office-addin-manifest": "^2.1.2",
        "playwright": "^1.58.1",
        "prettier": "^3.2.5",
        "rimraf": "^6.1.2",
        "standard-version": "^9.5.0",
        "terser-webpack-plugin": "^5.3.9",
        "typescript": "^5.9.3",
        "vitest": "^4.0.17",
        "wait-on": "^9.0.3",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.3",
        "webpack-merge": "^6.0.1"
    },
    "lint-staged": {
        "**/*.{ts,js,cjs,mjs,json,css,md,html}": [
            "prettier --write"
        ]
    },
    "overrides": {
        "tmp": "^0.2.3"
    }
}
