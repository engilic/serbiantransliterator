{
    "name": "serbian-transliterator",
    "version": "1.0.0",
    "license": "MIT",
    "scripts": {
        "build": "webpack --mode production",
        "dev-server": "webpack serve --mode development",
        "sideload:word": "office-addin-dev-settings sideload manifest.xml --app word",
        "sideload:word:wait": "wait-on --timeout 60000 https://localhost:3000/taskpane.html && npm run sideload:word",
        "dev": "concurrently -k \"npm:dev-server\" \"npm:sideload:word:wait\"",
        "noop": "node -e \"process.exit(0)\"",
        "debug:enable": "office-addin-debugging start manifest.xml --no-sideload --dev-server \"npm run noop\" --dev-server-port 3000",
        "debug:run": "npm run debug:enable && npm run sideload:word:wait",
        "start:debug": "concurrently -k \"npm:dev-server\" \"npm:debug:run\"",
        "start": "npm run start:debug",
        "stop": "office-addin-debugging stop manifest.xml",
        "validate": "office-addin-manifest validate manifest.xml",
        "validate:prod": "npx office-addin-manifest validate manifest.prod.xml",
        "test": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run",
        "test:watch": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest",
        "test:coverage": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run --coverage",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint src/**/*.ts --max-warnings 0",
        "lint:fix": "eslint src/**/*.ts --fix",
        "typecheck": "tsc --noEmit",
        "test:e2e": "playwright test",
        "serve:dist": "http-server dist -p 4173 -c-1",
        "clean": "rimraf dist",
        "deploy": "npm run build && wrangler pages deploy dist --project-name=serbiantransliterator",
        "check:conflicts": "node scripts/checkConflicts.cjs",
        "prepare": "husky install"
    },
    "lint-staged": {
        "**/*.{ts,js,json,css,md,html}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "core-js": "^3.36.0",
        "regenerator-runtime": "^0.14.1"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/preset-env": "^7.25.4",
        "@babel/preset-typescript": "^7.23.3",
        "@playwright/test": "^1.50.0",
        "@types/node": "^25.0.3",
        "@types/office-js": "^1.0.377",
        "@vitest/coverage-v8": "^4.0.17",
        "babel-loader": "^9.1.3",
        "concurrently": "^9.2.1",
        "copy-webpack-plugin": "^12.0.2",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.2",
        "eslint": "^8.57.1",
        "eslint-plugin-office-addins": "^3.0.3",
        "html-loader": "^5.0.0",
        "html-webpack-plugin": "^5.6.0",
        "http-server": "^14.1.1",
        "husky": "^8.0.3",
        "jsdom": "^27.4.0",
        "lint-staged": "^15.2.0",
        "mini-css-extract-plugin": "^2.9.4",
        "office-addin-debugging": "^6.0.6",
        "office-addin-dev-certs": "^2.0.3",
        "office-addin-dev-settings": "^3.0.6",
        "office-addin-manifest": "^2.0.3",
        "prettier": "^3.3.3",
        "rimraf": "^6.1.2",
        "terser-webpack-plugin": "^5.3.10",
        "typescript": "5.5.4",
        "vitest": "^4.0.17",
        "wait-on": "^7.2.0",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.2"
    },
    "overrides": {
        "esbuild": "0.27.2",
        "tmp": "0.2.5",
        "rimraf": "^6.1.2"
    }
}
