{
    "name": "serbian-transliterator",
    "version": "1.0.0",
    "description": "Offline-first Word add-in for Serbian transliteration (Lat <-> Cyr) powered by Rust/WASM.",
    "license": "MIT",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@9.1.0",
    "scripts": {
        "git:reset": "node scripts/git-cleanup.js",
        "git:cleanup": "node scripts/git-cleanup.js",
        "verify:all": "node scripts/verify-all.js",
        "verify:all:strict": "node scripts/verify-all.js --strict",
        "update:version": "node scripts/update-manifest-version.js",
        "clean": "rimraf dist coverage playwright-report test-results pkg src/wasm-core/pkg",
        "build:wasm": "cd src/wasm-core && wasm-pack build --target web --out-name index",
        "compile:dicts": "cd src/wasm-core && cargo run --bin compiler && cd ../..",
        "prebuild": "pnpm run clean && pnpm run update:version",
        "build": "pnpm run build:wasm && pnpm run compile:dicts && webpack --mode production",
        "dev-server": "pnpm run build:wasm && pnpm run compile:dicts && webpack serve --mode development",
        "start": "pnpm run dev-server",
        "sideload:word": "office-addin-dev-settings sideload manifest.xml --app word",
        "dev": "concurrently \"pnpm run start\" \"wait-on https://localhost:3000/taskpane.html && pnpm run sideload:word\"",
        "validate": "office-addin-manifest validate manifest.xml",
        "validate:prod": "office-addin-manifest validate manifest.prod.xml",
        "test": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run",
        "test:coverage": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:trace": "playwright test --trace=retain-on-failure",
        "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "typecheck": "tsc --noEmit",
        "serve:dist": "http-server dist -p 4173 -c-1",
        "check:conflicts": "node scripts/checkConflicts.cjs",
        "check:i18n": "node scripts/checkI18nKeys.cjs && node scripts/checkUserFacingStrings.cjs && node scripts/checkTaskpaneHtmlI18n.cjs",
        "format:check": "prettier --check .",
        "format:fix": "prettier --write .",
        "audit:high": "pnpm audit --audit-level=high",
        "audit:prod:high": "pnpm audit --prod --audit-level=high",
        "release": "node scripts/release.js"
    },
    "dependencies": {
        "@xmldom/xmldom": "^0.9.9",
        "core-js": "^3.49.0",
        "dompurify": "^3.3.3",
        "idb": "^8.0.3",
        "jszip": "^3.10.1",
        "regenerator-runtime": "^0.14.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.2",
        "@babel/core": "^7.29.0",
        "@babel/preset-env": "^7.29.2",
        "@babel/preset-typescript": "^7.28.5",
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@playwright/test": "^1.59.1",
        "@types/node": "^25.6.0",
        "@types/office-js": "^1.0.588",
        "@vitest/coverage-v8": "^4.1.4",
        "@wasm-tool/wasm-pack-plugin": "^1.7.0",
        "babel-loader": "^10.1.1",
        "compression-webpack-plugin": "^12.0.0",
        "concurrently": "^9.2.1",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.4",
        "eslint": "^8.57.1",
        "eslint-plugin-deprecation": "^3.0.0",
        "eslint-plugin-office-addins": "^3.0.3",
        "fast-check": "^4.6.0",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.6",
        "http-server": "^14.1.1",
        "husky": "^9.1.7",
        "jsdom": "^22.1.0",
        "lint-staged": "^16.4.0",
        "mini-css-extract-plugin": "^2.10.2",
        "office-addin-debugging": "^6.0.7",
        "office-addin-dev-certs": "^2.0.7",
        "office-addin-dev-settings": "^3.0.7",
        "office-addin-manifest": "^2.1.3",
        "playwright": "^1.59.1",
        "prettier": "^3.8.2",
        "rimraf": "^6.1.3",
        "standard-version": "^9.5.0",
        "terser-webpack-plugin": "^5.4.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.4",
        "wait-on": "^9.0.5",
        "webpack": "^5.106.1",
        "webpack-cli": "^7.0.2",
        "webpack-dev-server": "^5.2.3",
        "webpack-merge": "^6.0.1",
        "workbox-precaching": "^7.4.0",
        "workbox-routing": "^7.4.0",
        "workbox-strategies": "^7.4.0",
        "workbox-webpack-plugin": "^7.4.0"
    },
    "lint-staged": {
        "**/*.{ts,js,cjs,mjs,json,css,md,html}": [
            "prettier --write"
        ]
    },
    "volta": {
        "node": "22.12.0",
        "pnpm": "9.1.0"
    },
    "pnpm": {
        "overrides": {
            "tmp": "^0.2.4",
            "playwright-core": "$@playwright/test",
            "qs": "6.14.2"
        }
    }
}
