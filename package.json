{
    "name": "serbian-transliterator",
    "version": "1.0.0",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    },
    "scripts": {
        "build": "webpack --mode production",
        "dev-server": "webpack serve --mode development",
        "sideload:word": "office-addin-dev-settings sideload manifest.xml --app word",
        "sideload:word:wait": "wait-on --timeout 60000 https://localhost:3000/taskpane.html && npm run sideload:word",
        "dev": "concurrently -k \"npm:dev-server\" \"npm:sideload:word:wait\"",
        "noop": "node -e \"process.exit(0)\"",
        "debug:enable": "office-addin-debugging start manifest.xml --no-sideload --dev-server \"npm run noop\" --dev-server-port 3000",
        "debug:run": "npm run debug:enable && npm run sideload:word:wait",
        "start:debug": "concurrently -k \"npm:dev-server\" \"npm:debug:run\"",
        "start": "npm run start:debug",
        "stop": "office-addin-debugging stop manifest.xml",
        "validate": "office-addin-manifest validate manifest.xml",
        "validate:prod": "office-addin-manifest validate manifest.prod.xml",
        "test": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run",
        "test:watch": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest",
        "test:coverage": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run --coverage",
        "test:e2e": "playwright test",
        "test:ci": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run validate && npm run validate:prod && npm run test:e2e",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint src/**/*.ts --max-warnings 0",
        "lint:fix": "eslint src/**/*.ts --fix",
        "typecheck": "tsc --noEmit",
        "serve:dist": "http-server dist -p 4173 -c-1",
        "clean": "rimraf dist",
        "deploy": "npm run build && wrangler pages deploy dist --project-name=serbiantransliterator",
        "check:conflicts": "node scripts/checkConflicts.cjs",
        "prepare": "husky install",
        "check:i18n:ts": "node scripts/checkUserFacingStrings.cjs",
        "check:i18n:html": "node scripts/checkTaskpaneHtmlI18n.cjs",
        "check:i18n": "npm run check:i18n:ts && npm run check:i18n:html",
        "audit:high": "npm audit --audit-level=high",
        "ai:pack": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./poruke-za-ai.ps1 -base . -outDir . -clean",
        "test:perf": "vitest run tests/performanceMonitor.test.ts tests/errorRecovery.test.ts tests/modalManager.test.ts",
        "export:perf": "node -e \"console.log(require('./dist/taskpane.js').perfMonitor.exportCsv())\"",
        "analyze:bundle": "webpack-bundle-analyzer dist/stats.json",
        "test:unit": "cross-env VITE_CJS_IGNORE_WARNING=1 vitest run --coverage",
        "test:integration": "npm run test:e2e",
        "build:analyze": "webpack --mode production --stats-json && webpack-bundle-analyzer dist/stats.json",
        "clean:dist": "rimraf dist coverage .vitest",
        "prepare:dev": "npm ci && npm run build",
        "audit:deps": "npm audit --production",
        "update:check": "npm outdated"
    },
    "lint-staged": {
        "**/*.{ts,js,cjs,mjs,json,css,md,html}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "core-js": "^3.37.1",
        "regenerator-runtime": "^0.14.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.0",
        "@babel/core": "^7.25.2",
        "@babel/preset-env": "^7.25.4",
        "@babel/preset-typescript": "^7.24.7",
        "@commitlint/cli": "^20.3.1",
        "@commitlint/config-conventional": "^20.3.1",
        "@playwright/test": "^1.44.1",
        "@types/node": "^25.0.9",
        "@types/office-js": "^1.0.568",
        "@vitest/coverage-v8": "^4.0.17",
        "@wasm-tool/wasm-pack-plugin": "^1.7.0",
        "babel-loader": "^9.1.3",
        "concurrently": "^9.2.1",
        "copy-webpack-plugin": "^11.0.0",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.2",
        "eslint": "^8.57.0",
        "eslint-plugin-office-addins": "^3.0.3",
        "html-loader": "^5.1.0",
        "html-webpack-plugin": "^5.6.6",
        "http-server": "^14.1.1",
        "husky": "^9.1.7",
        "jsdom": "^22.1.0",
        "lint-staged": "^16.2.7",
        "mini-css-extract-plugin": "^2.10.0",
        "office-addin-debugging": "^6.0.6",
        "office-addin-dev-certs": "^2.0.6",
        "office-addin-dev-settings": "^3.0.6",
        "office-addin-manifest": "^2.1.2",
        "prettier": "^3.2.5",
        "rimraf": "^5.0.5",
        "terser-webpack-plugin": "^5.3.9",
        "typescript": "^5.9.3",
        "vitest": "^4.0.17",
        "wait-on": "^9.0.3",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.3",
        "webpack-merge": "^6.0.1",
        "wrangler": "^4.59.3"
    },
    "overrides": {
        "esbuild": "0.27.2",
        "tmp": "0.2.5",
        "rimraf": "^5.0.5",
        "undici": "6.23.0"
    }
}
